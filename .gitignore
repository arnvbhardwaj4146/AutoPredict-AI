# ==================================================
# AutoPredict AI — Git Ignore Rules
# ==================================================

# Python Virtual Environments
venv/
backend/venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/

# Node & Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
.vite/
*.local

# Environment Variables & Secrets
.env
.env.*
*.env
*.key
*.pem
*.cert

# Database & Runtime Data Files
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Ensure Essential Project Data & Artifacts are explicitly TRACKED
!backend/data/model_metrics.json
!backend/data/vehicle_data.csv
!backend/app/ml/saved_models/*.joblib
!backend/app/ml/saved_models/*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
